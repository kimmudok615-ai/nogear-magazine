<?xml version="1.0" encoding="UTF-8"?>
<!-- 다크사이드 계정 하루치(캐러셀 2편). 설치는 맥에서 직접:
       cp ops/com.darkside.daily.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.darkside.daily.plist
     08:30(생성+1편 게시) · 19:30(나머지 1편 게시) 에 돈다. 로그: ~/nogear-magazine/data/dark_daily.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.darkside.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string><string>-lc</string>
    <string>~/nogear-magazine/ops/dark_daily.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NOGEAR_ROOT</key><string>/Users/andy/nogear</string>
    <key>DARK_PUBLIC_BASE</key><string>https://nogear-magazine.vercel.app</string>
    <!-- DARK_IG_TOKEN · DARK_IG_USER_ID 는 여기 쓰지 말고 ~/.zprofile 등 셸 환경에 둔다 -->
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>   <!-- 생성 + 1편 게시 -->
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>30</integer></dict>  <!-- 나머지 1편 게시 -->
  </array>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
